      echo "  Wildcard: only if you also plan subdomains like blog.domain.com."
      ;;
    django)
      badge_info "Django"
      echo "  Point the backend to Gunicorn, uWSGI, or Daphne/ASGI on a reachable"
      echo "  address. That may be localhost, another container, or another server"
      echo "  on the LAN."
      echo "  Common patterns are http://127.0.0.1:8000, http://10.0.0.20:8000,"
      echo "  or any trusted internal URL."
      echo "  Keep Django behind the proxy and let Nginx handle TLS, headers,"
      echo "  and public routing."
      echo "  SSL on reverse: yes for public access."
      echo "  Wildcard: yes only if you expect multiple subdomains."
      ;;
    flask-fastapi)
      badge_info "Flask / FastAPI"
      echo "  Use the app server address directly, usually Gunicorn or Uvicorn."
      echo "  The backend can listen on this server or a different machine in the"
      echo "  same network, as long as Nginx can reach it."
      echo "  Typical inputs look like http://127.0.0.1:5000, http://10.0.0.20:5000,"
      echo "  or another trusted internal URL."
      echo "  This script is the front door, so SSL on reverse is usually yes."
      echo "  Wildcard: only if the app is meant to answer on subdomains too."
      ;;
    static)
      badge_info "Static site"
      echo "  Use the port where the static server or panel serves files."
      echo "  That may be a local service, a separate host on the LAN, or a panel"
