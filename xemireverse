#!/usr/bin/env bash
###############################################################################
# Reverse Manager 3.7.0
#
# English version, professional TUI, safe-by-default Nginx reverse manager.
#
# Key guarantees
# 1) No unresolved placeholders allowed in generated configs
# 2) Atomic writes, CRLF and non printable sanitization
# 3) Full Nginx validation before reload
# 4) Automatic backup and rollback on failure
# 5) Audit and sanitize existing conf.d files
# 6) When deleting a domain, remove associated files (conf and certs)
# 7) Proxy behaviour follows the capabilities an application declares,
#    it is never inferred from backing services such as Redis
#
# DB format, current
# domain;backend_url;wildcard=yes|no;ssl=yes|no;mode=generated|manual;\
#   profile=<slug>;websocket=yes|no;websocket_path=/ws/
#
# Every field after the backend URL is a key=value pair, so older rows written
# by 3.5 and 3.6 stay valid. Missing keys fall back to safe defaults:
#   mode=generated, profile=generic, websocket=no, websocket_path=/ws/
###############################################################################

set -Eeuo pipefail
IFS=$'\n\t'

###############################################################################
# Configuration
###############################################################################
APP_NAME="Reverse Manager"
APP_VERSION="3.7.0"

NGINX_CONF_DIR="/etc/nginx/conf.d"
DB_FILE="/etc/nginx/reverse-manager.db"
CERT_DIR="/etc/ssl/cloudflare"
BACKUP_DIR="/var/backups/reverse-manager"
LOG_FILE="/var/log/reverse-manager.log"

MIN_DELAY="0.25"
SELECTED_DOMAIN=""
EDIT_DIRTY=0
SESSION_BACKUP_PATH=""

DEFAULT_CLIENT_MAX_BODY_SIZE="512m"
DEFAULT_PROXY_CONNECT_TIMEOUT="60"
DEFAULT_PROXY_SEND_TIMEOUT="600"
DEFAULT_PROXY_READ_TIMEOUT="600"
DEFAULT_CLIENT_BODY_TIMEOUT="300"
DEFAULT_SEND_TIMEOUT="300"

# Application capabilities
# A capability describes proxy behaviour the application actually needs.
# It is declared by the operator, never guessed from the stack behind the
# backend. WebSocket is the first one.
DEFAULT_PROFILE="generic"
DEFAULT_WEBSOCKET="no"
DEFAULT_WEBSOCKET_PATH="/ws/"

# WebSocket connections idle between frames, so they get their own timeouts
# instead of the shorter request oriented ones above.
DEFAULT_WEBSOCKET_READ_TIMEOUT="600"
DEFAULT_WEBSOCKET_SEND_TIMEOUT="600"

# Parsed DB row, filled by parse_entry
ENTRY_DOMAIN=""
ENTRY_BACKEND_URL=""
ENTRY_WILDCARD="no"
ENTRY_SSL="no"
ENTRY_MODE="generated"
ENTRY_PROFILE="$DEFAULT_PROFILE"
ENTRY_WEBSOCKET="$DEFAULT_WEBSOCKET"
ENTRY_WEBSOCKET_PATH="$DEFAULT_WEBSOCKET_PATH"
# Set when the row stores a websocket_path that does not validate
ENTRY_WEBSOCKET_INVALID=0

# Answers collected by the capability prompts
ASK_WEBSOCKET="$DEFAULT_WEBSOCKET"
ASK_WEBSOCKET_PATH="$DEFAULT_WEBSOCKET_PATH"

# Forbidden tokens inside conf files
FORBIDDEN_TOKENS_REGEX='__[^ _][^ ]*__'

###############################################################################
# Colors and UI
###############################################################################
RESET=$'\e[0m'
BOLD=$'\e[1m'
DIM=$'\e[2m'

FG_RED=$'\e[31m'
FG_GREEN=$'\e[32m'
FG_YELLOW=$'\e[33m'
FG_BLUE=$'\e[34m'
FG_MAGENTA=$'\e[35m'
FG_CYAN=$'\e[36m'
FG_GRAY=$'\e[90m'

# UI symbols
SYM_OK="✓"
SYM_WARN="!"
SYM_FAIL="✗"
SYM_INFO="i"
SYM_ARROW="›"

BOX_W=78

###############################################################################
# Base utilities
###############################################################################
sleep_soft() { sleep "$MIN_DELAY"; }

now_ts() { date +"%Y-%m-%d %H:%M:%S"; }
now_stamp() { date +"%Y%m%d_%H%M%S"; }

log_line() {
  local level="$1"
  local msg="$2"
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  printf "%s [%s] %s\n" "$(now_ts)" "$level" "$msg" >>"$LOG_FILE" 2>/dev/null || true
}

die() {
  local msg="$1"
  echo -e "${FG_RED}${BOLD}${SYM_FAIL} Error${RESET}, ${msg}"
  log_line "ERROR" "$msg"
  exit 1
}

require_root() {
  if [[ "${EUID:-0}" -ne 0 ]]; then
    die "this script must be run as root"
  fi
}

ensure_paths() {
  mkdir -p "$NGINX_CONF_DIR" "$CERT_DIR" "$BACKUP_DIR"
  [[ -f "$DB_FILE" ]] || : >"$DB_FILE"
}

repeat_char() {
  local char="$1"
  local count="$2"
  printf "%*s" "$count" "" | tr " " "$char"
}

box_line() {
  local text="$1"
  local pad=$((BOX_W - 4 - ${#text}))
  (( pad < 0 )) && pad=0
  printf "  %s %s%s%s\n" "│" "$text" "$(repeat_char " " "$pad")" " │"
}

box_top() { printf "  %s%s%s\n" "┌" "$(repeat_char "─" $((BOX_W - 2)))" "┐"; }
box_bot() { printf "  %s%s%s\n" "└" "$(repeat_char "─" $((BOX_W - 2)))" "┘"; }

clear_screen() { clear; }

header() {
  clear_screen
  box_top
  box_line "${FG_CYAN}${BOLD}${APP_NAME}${RESET} ${FG_GRAY}${APP_VERSION}${RESET}"
  box_line "${FG_GRAY}Nginx reverse proxy control, Cloudflare friendly, safe by default${RESET}"
  box_bot
  echo
}

badge_ok() { echo -e "${FG_GREEN}${BOLD}${SYM_OK}${RESET} $*"; }
badge_warn() { echo -e "${FG_YELLOW}${BOLD}${SYM_WARN}${RESET} $*"; }
badge_fail() { echo -e "${FG_RED}${BOLD}${SYM_FAIL}${RESET} $*"; }
badge_info() { echo -e "${FG_CYAN}${BOLD}${SYM_INFO}${RESET} $*"; }

pause() {
  echo
  read -r -p "Press Enter to continue... " _
}

ask_yes_no() {
  # returns 0 for yes, 1 for no
  local prompt="$1"
  local ans=""
  while true; do
    read -r -p "${prompt} (y, n): " ans
    ans="${ans,,}"
    if [[ "$ans" == "y" || "$ans" == "yes" ]]; then
      return 0
    fi
    if [[ "$ans" == "n" || "$ans" == "no" ]]; then
      return 1
    fi
    badge_warn "invalid answer, use y or n"
  done
}

ask_choice() {
  # Usage: ask_choice "Prompt" "1 2 3"
  local prompt="$1"
  local allowed="$2"
  local ans=""
  while true; do
    read -r -p "$prompt: " ans
    if echo " $allowed " | grep -q " $ans "; then
      printf "%s" "$ans"
      return 0
    fi
    badge_warn "invalid option"
  done
}

###############################################################################
# Sanitization, editor helpers, and safe writes
###############################################################################
sanitize_text_file_inplace() {
  local f="$1"
  sed -i 's/\r$//' "$f" 2>/dev/null || true
  LC_ALL=C tr -cd '\11\12\15\40-\176' <"$f" >"${f}.clean" 2>/dev/null || true
  mv -f "${f}.clean" "$f" 2>/dev/null || true
}

choose_text_editor() {
  local candidate
  for candidate in "${VISUAL:-}" "${EDITOR:-}" nano vi; do
    [[ -n "$candidate" ]] || continue
    local -a parts=()
    read -r -a parts <<<"$candidate"
    if command -v "${parts[0]}" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

open_file_in_editor() {
  local file="$1"
  local editor
  editor="$(choose_text_editor)" || return 1

  local -a cmd=()
  read -r -a cmd <<<"$editor"
  "${cmd[@]}" "$file"
}

editor_supports_manual_edit() {
  choose_text_editor >/dev/null 2>&1
}

write_atomic() {
  local target="$1"
  local tmp="${target}.tmp.$$"
  umask 022
  cat >"$tmp"
  sanitize_text_file_inplace "$tmp"
  chmod 644 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$target"
}

###############################################################################
# Backups and rollback
###############################################################################
backup_reverse_state() {
  local stamp
  stamp="$(now_stamp)"
  local dest="${BACKUP_DIR}/nginx_conf_backup_${stamp}"
  mkdir -p "$dest"
  cp -a "$NGINX_CONF_DIR" "$dest/" 2>/dev/null || true
  cp -a "$DB_FILE" "$dest/" 2>/dev/null || true
  cp -a "$CERT_DIR" "$dest/" 2>/dev/null || true
  echo "$dest"
}

backup_nginx_confs() {
  backup_reverse_state
}

restore_reverse_state() {
  local backup_path="$1"
  if [[ -d "$backup_path/conf.d" ]]; then
    rm -rf "$NGINX_CONF_DIR"
    mkdir -p "$NGINX_CONF_DIR"
    cp -a "$backup_path/conf.d/." "$NGINX_CONF_DIR/"
  fi

  if [[ -f "$backup_path/$(basename "$DB_FILE")" ]]; then
    cp -a "$backup_path/$(basename "$DB_FILE")" "$DB_FILE"
  fi

  if [[ -d "$backup_path/$(basename "$CERT_DIR")" ]]; then
    rm -rf "$CERT_DIR"
    mkdir -p "$CERT_DIR"
    cp -a "$backup_path/$(basename "$CERT_DIR")/." "$CERT_DIR/"
  fi

  if [[ -d "$backup_path/$NGINX_CONF_DIR" ]]; then
    rm -rf "$NGINX_CONF_DIR"
    mkdir -p "$NGINX_CONF_DIR"
    cp -a "$backup_path/$NGINX_CONF_DIR/." "$NGINX_CONF_DIR/"
  fi

  return 0
}

restore_nginx_confs() {
  restore_reverse_state "$1"
}

build_proxy_headers_block() {
  # Forwarding headers shared by every generated location.
  cat <<'EOF'
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
EOF
}

build_location_http_block() {
  # Plain HTTP reverse proxy location.
  # Connection "" clears the inbound hop by hop header so keepalive to the
  # backend works. It deliberately does not carry an Upgrade handshake.
  local backend_url="$1"
  local proxy_ssl_block="$2"

  cat <<EOF
    location / {
        proxy_pass ${backend_url};
${proxy_ssl_block}$(build_proxy_tuning_block)

$(build_proxy_headers_block)

        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
EOF
}

build_location_websocket_block() {
  # WebSocket capable location.
  # Upgrade and Connection are hop by hop headers, Nginx drops them unless they
  # are forwarded explicitly, which is why a generic location delivers the
  # handshake to the backend as an ordinary HTTP request.
  #
  # Connection is set to the literal "upgrade" instead of the usual
  # map $http_upgrade $connection_upgrade pattern. The map exists so that one
  # shared location can serve both upgrade and non upgrade traffic, and it only
  # lives in the http context. Since this location is emitted per domain under
  # conf.d, a map here would either be duplicated across domains, which Nginx
  # rejects, or would have to live in a shared file that can collide with a
  # connection_upgrade map already defined by the distribution or a panel.
  # A dedicated WebSocket location does not need the conditional form.
  local backend_url="$1"
  local proxy_ssl_block="$2"
  local websocket_path="$3"

  cat <<EOF
    location ${websocket_path} {
        proxy_pass ${backend_url};
${proxy_ssl_block}$(build_proxy_tuning_block "$DEFAULT_WEBSOCKET_READ_TIMEOUT" "$DEFAULT_WEBSOCKET_SEND_TIMEOUT")

$(build_proxy_headers_block)

        proxy_http_version 1.1;
        proxy_set_header Upgrade           \$http_upgrade;
        proxy_set_header Connection        "upgrade";
    }
EOF
}

build_locations_block() {
  # Assembles the location set required by the declared capabilities.
  local backend_url="$1"
  local proxy_ssl_block="$2"
  local websocket="$3"
  local websocket_path="$4"

  local block
  block="$(build_location_http_block "$backend_url" "$proxy_ssl_block")"

  if [[ "$websocket" == "yes" ]]; then
    block+=$'\n\n'
    block+="$(build_location_websocket_block "$backend_url" "$proxy_ssl_block" "$websocket_path")"
  fi

  printf '%s\n' "$block"
}

render_nginx_conf() {
  local domain="$1"
  local backend_url="$2"
  local wildcard="$3"
  local ssl="$4"
  # Capability and profile arguments are optional so any caller that still uses
  # the 3.6 signature renders a plain HTTP vhost, exactly as before.
  local websocket="${5:-$DEFAULT_WEBSOCKET}"
  local websocket_path="${6:-$DEFAULT_WEBSOCKET_PATH}"
  local profile="${7:-$DEFAULT_PROFILE}"

  [[ "$websocket" == "yes" ]] || websocket="no"

  local server_name_line=""
  if [[ "$wildcard" == "yes" ]]; then
    server_name_line="server_name ${domain} *.${domain};"
  else
    server_name_line="server_name ${domain} www.${domain};"
  fi

  local cert_file="${CERT_DIR}/${domain}.pem"
  local key_file="${CERT_DIR}/${domain}.key"

  local proxy_ssl_block=""
  if [[ "$backend_url" == https://* ]]; then
    # Applies to every location, so an https backend also covers wss traffic.
    proxy_ssl_block=$'        proxy_ssl_server_name on;\n        proxy_ssl_verify off;\n'
  fi

  local websocket_note="no"
  if [[ "$websocket" == "yes" ]]; then
    websocket_note="yes, path ${websocket_path}"
  fi

  local locations_block
  locations_block="$(build_locations_block \
    "$backend_url" "$proxy_ssl_block" "$websocket" "$websocket_path")"

  cat <<EOF
##
## Auto generated by ${APP_NAME} ${APP_VERSION}
## Domain, ${domain}
## Backend, ${backend_url}
## Profile, ${profile}
## Wildcard, ${wildcard}
## SSL, ${ssl}
## WebSocket, ${websocket_note}
##

EOF

  if [[ "$ssl" == "yes" ]]; then
    cat <<EOF
server {
    listen 80;
    ${server_name_line}
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    ${server_name_line}

    ssl_certificate     ${cert_file};
    ssl_certificate_key ${key_file};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

${locations_block}
}

EOF
  else
    cat <<EOF
server {
    listen 80;
    ${server_name_line}

${locations_block}
}

EOF
  fi
}

validate_conf_for_domain() {
  local conf="$1"
  conf_must_not_contain_cr "$conf" || return 1
  conf_must_not_contain_forbidden_tokens "$conf" || return 1
  return 0
}

domain_conf_path() {
  local domain="$1"
  printf '%s/%s.conf' "$NGINX_CONF_DIR" "$domain"
}

ensure_domain_conf_present() {
  local domain="$1"
  local backend_url="$2"
  local wildcard="$3"
  local ssl="$4"
  local websocket="${5:-$DEFAULT_WEBSOCKET}"
  local websocket_path="${6:-$DEFAULT_WEBSOCKET_PATH}"
  local profile="${7:-$DEFAULT_PROFILE}"
  local conf_path
  conf_path="$(domain_conf_path "$domain")"

  if [[ ! -f "$conf_path" ]]; then
    # A stored capability that no longer validates is not rendered with a
    # substituted path. The domain stays without a conf until the operator
    # fixes or disables it from the edit menu.
    if [[ "$websocket" == "yes" ]] \
      && ! normalize_websocket_path "$websocket_path" >/dev/null 2>&1; then
      badge_warn "config missing for ${domain}, not regenerated, stored websocket path is invalid"
      log_line "WARN" "Skipped regeneration for ${domain}, invalid stored websocket path"
      return 0
    fi

    generate_nginx_conf "$domain" "$backend_url" "$wildcard" "$ssl" \
      "$websocket" "$websocket_path" "$profile"
  fi
}

reload_nginx_portable() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl reload nginx >/dev/null 2>&1 && return 0
  fi

  if command -v service >/dev/null 2>&1; then
    service nginx reload >/dev/null 2>&1 && return 0
  fi

  if command -v nginx >/dev/null 2>&1; then
    nginx -s reload >/dev/null 2>&1 && return 0
  fi

  return 1
}

###############################################################################
# Validation
###############################################################################
validate_domain() {
  local d="$1"
  [[ -n "$d" ]] || return 1
  [[ "$d" != *"://"* ]] || return 1
  [[ "$d" != */* ]] || return 1
  [[ "$d" != *" "* ]] || return 1
  [[ "$d" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]] || return 1
  return 0
}

normalize_backend_url() {
  local input="$1"
  input="$(printf '%s' "$input" | xargs)"
  [[ -n "$input" ]] || return 1
  if [[ "$input" != http://* && "$input" != https://* ]]; then
    input="http://$input"
  fi
  input="${input%/}"
  local rest="${input#*://}"
  [[ -n "$rest" ]] || return 1
  [[ "$rest" != *" "* ]] || return 1
  printf '%s\n' "$input"
  return 0
}

normalize_websocket_path() {
  # Structured input only, never raw Nginx syntax.
  # Accepts /ws/, /socket/, /ws/chat/ and prints the normalized prefix path.
  # Rejects anything that is not a plain absolute path, which keeps user input
  # from reaching the config as a directive, a comment, or a new block.
  local input="$1"

  # Trim surrounding whitespace only, any whitespace left inside is a reject
  input="${input#"${input%%[![:space:]]*}"}"
  input="${input%"${input##*[![:space:]]}"}"

  [[ -n "$input" ]] || return 1
  (( ${#input} <= 128 )) || return 1
  [[ "$input" == /* ]] || return 1
  [[ "$input" =~ ^/[A-Za-z0-9._~/-]*$ ]] || return 1
  [[ "$input" != *"//"* ]] || return 1
  [[ "$input" != *".."* ]] || return 1
  # A bare / would collide with the root location and break the vhost
  [[ "$input" != "/" ]] || return 1

  # Prefix locations behave predictably with a trailing slash, /ws would also
  # match /wsadmin
  [[ "$input" == */ ]] || input="${input}/"

  printf '%s\n' "$input"
  return 0
}

profile_slug_from_choice() {
  # Maps the deployment type menu answer to the value persisted in the DB
  case "$1" in
    1) printf 'wordpress-php' ;;
    2) printf 'django' ;;
    3) printf 'flask-fastapi' ;;
    4) printf 'static' ;;
    *) printf 'generic' ;;
  esac
}

profile_label() {
  case "$1" in
    wordpress-php) printf 'WordPress / PHP' ;;
    django) printf 'Django' ;;
    flask-fastapi) printf 'Flask / FastAPI' ;;
    static) printf 'Static site' ;;
    *) printf 'Generic service' ;;
  esac
}

