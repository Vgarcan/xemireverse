    *)
      badge_info "Generic service"
      echo "  The backend must be an HTTP service reachable from this machine."
      echo "  Think in terms of the origin address, not the public hostname."
      echo "  Example forms: http://127.0.0.1:8080, http://192.168.1.50:9000,"
      echo "  http://10.0.0.20:9000, or a panel-managed internal vhost."
      echo "  SSL on reverse: yes for public traffic."
      echo "  Wildcard: only when you want multiple subdomains on the same record."
      ;;
  esac
  echo
}

ask_websocket_path() {
  # Prompts until the answer is a safe prefix path. Sets ASK_WEBSOCKET_PATH.
  local current="$1"
  local raw=""
  local normalized=""

  while true; do
    read -r -p "WebSocket path [${current}]: " raw
    [[ -n "$raw" ]] || raw="$current"

    if normalized="$(normalize_websocket_path "$raw")"; then
      ASK_WEBSOCKET_PATH="$normalized"
      if [[ "$normalized" != "$raw" ]]; then
        badge_info "path normalized to ${normalized}"
      fi
      return 0
    fi

    badge_warn "invalid path, use an absolute prefix such as /ws/ or /ws/chat/"
  done
}

ask_websocket_capability() {
  # Capability question for create. Sets ASK_WEBSOCKET and ASK_WEBSOCKET_PATH.
  # The profile only tunes the hint shown, it never decides the answer.
  local profile="$1"
  local current_path="$2"

  ASK_WEBSOCKET="no"
  ASK_WEBSOCKET_PATH="$current_path"

  echo
  echo -e "${FG_CYAN}${BOLD}Application capabilities${RESET}"
  echo

  case "$profile" in
    django)
      echo "  Django served through ASGI, Daphne or Uvicorn, with Channels"
      echo "  realtime endpoints usually needs this."
      ;;
    flask-fastapi)
      echo "  FastAPI or Starlette WebSocket endpoints need this."
      ;;
    wordpress-php)
      echo "  Classic PHP sites normally do not need this."
      ;;
    static)
      echo "  Static sites normally do not need this."
      ;;
    *)
      echo "  Enable this only if the application serves WebSocket traffic."
      ;;
  esac

  echo "  The proxy only needs to know whether a path carries WebSocket"
  echo "  traffic. Backing services such as Redis are not a proxy concern."
  echo

  if ask_yes_no "does this application use WebSockets"; then
    ASK_WEBSOCKET="yes"
    ask_websocket_path "$current_path"
  else
    # Keep the stored path so re-enabling later offers the previous value
    ASK_WEBSOCKET_PATH="$current_path"
  fi

  return 0
}

conf_must_not_contain_forbidden_tokens() {
  local conf="$1"
  if grep -Eq "$FORBIDDEN_TOKENS_REGEX" "$conf"; then
    return 1
  fi
  return 0
}

conf_must_not_contain_cr() {
  local conf="$1"
  if LC_ALL=C grep -q $'\r' "$conf" 2>/dev/null; then
    return 1
  fi
  return 0
}

nginx_test_quiet() {
  nginx -t >/dev/null 2>&1
}

nginx_test_verbose() {
  nginx -t
}

safe_reload_nginx() {
  local backup_path="$1"

  if ! nginx_test_quiet; then
    badge_fail "nginx config test failed, reload aborted"
    log_line "WARN" "nginx test failed before reload"
    nginx_test_verbose || true

    badge_warn "starting rollback"
    if restore_reverse_state "$backup_path"; then
      nginx_test_verbose || true
      log_line "WARN" "rollback applied"
    else
      badge_fail "rollback failed, check backup folder"
      log_line "ERROR" "rollback failed"
    fi
    return 1
  fi

  if reload_nginx_portable; then
    badge_ok "nginx reloaded successfully"
    log_line "INFO" "nginx reloaded"
    return 0
  fi

  badge_fail "reload failed, applying rollback"
  log_line "ERROR" "nginx reload failed"

  if restore_reverse_state "$backup_path"; then
    reload_nginx_portable || true
    badge_warn "rollback applied"
    log_line "WARN" "rollback applied after reload fail"
  else
    badge_fail "rollback failed"
    log_line "ERROR" "rollback failed after reload fail"
  fi
  return 1
}

###############################################################################
# DB exact match
###############################################################################
db_get_entry_exact() {
  local domain="$1"
  awk -F';' -v d="$domain" '$1==d {print; found=1; exit} END{exit found?0:1}' "$DB_FILE"
}

db_entry_exists() {
  local domain="$1"
  db_get_entry_exact "$domain" >/dev/null 2>&1
}

db_save_entry() {
  local domain="$1"
  local backend_url="$2"
  local wildcard="$3"
  local ssl="$4"
  local mode="${5:-generated}"
  local profile="${6:-$DEFAULT_PROFILE}"
  local websocket="${7:-$DEFAULT_WEBSOCKET}"
  local websocket_path="${8:-$DEFAULT_WEBSOCKET_PATH}"

  [[ "$websocket" == "yes" ]] || websocket="no"
  [[ -n "$profile" ]] || profile="$DEFAULT_PROFILE"

  # Write boundary for the capability.
  # With the capability enabled the path is load bearing, so an unusable value
  # is refused rather than converted, otherwise the registry would end up
  # declaring an endpoint the operator never asked for.
  # With the capability disabled the field is inert, so it is normalized to the
  # default instead of blocking an unrelated edit.
  local normalized_path=""
  if normalized_path="$(normalize_websocket_path "$websocket_path")"; then
    websocket_path="$normalized_path"
  elif [[ "$websocket" == "yes" ]]; then
    badge_fail "refusing to store an invalid websocket path for ${domain}"
    log_line "ERROR" "Registry write refused for ${domain}, invalid websocket path"
    return 1
  else
    websocket_path="$DEFAULT_WEBSOCKET_PATH"
  fi

  if db_entry_exists "$domain"; then
    awk -F';' -v OFS=';' -v d="$domain" -v b="$backend_url" -v w="$wildcard" \
      -v s="$ssl" -v m="$mode" -v p="$profile" -v ws="$websocket" -v wp="$websocket_path" '
      $1==d {print d,b,"wildcard="w,"ssl="s,"mode="m,"profile="p,"websocket="ws,"websocket_path="wp; next}
      {print}
    ' "$DB_FILE" > "${DB_FILE}.tmp" && mv -f "${DB_FILE}.tmp" "$DB_FILE"
  else
    printf '%s;%s;wildcard=%s;ssl=%s;mode=%s;profile=%s;websocket=%s;websocket_path=%s\n' \
      "$domain" "$backend_url" "$wildcard" "$ssl" "$mode" \
      "$profile" "$websocket" "$websocket_path" >> "$DB_FILE"
  fi
}

db_delete_entry() {
  local domain="$1"
  awk -F';' -v d="$domain" '$1!=d {print}' "$DB_FILE" > "${DB_FILE}.tmp" && mv -f "${DB_FILE}.tmp" "$DB_FILE"
}

entry_has_field() {
  # True when the row actually carries the key, whatever its value.
  # The difference matters, a missing key is an older row that takes the
  # default, a key that is present but unusable is corrupted data.
  local entry="$1"
  local key="$2"

  printf '%s' "$entry" | awk -F';' -v k="$key" '{
    for (i = 3; i <= NF; i++) {
      eq = index($i, "=")
      if (eq > 0 && substr($i, 1, eq - 1) == k) { found = 1; exit }
    }
  } END { exit found ? 0 : 1 }'
}

entry_field_value() {
  # Reads a key=value field from a DB row, printing the default when the key is
  # absent. This is what keeps rows written by older versions readable, they
  # simply do not carry the newer keys.
  local entry="$1"
  local key="$2"
  local default="${3:-}"

  printf '%s' "$entry" | awk -F';' -v k="$key" -v d="$default" '{
    # Fields 1 and 2 are the domain and the backend URL, keys start at 3
    for (i = 3; i <= NF; i++) {
      eq = index($i, "=")
      if (eq > 0 && substr($i, 1, eq - 1) == k) {
        print substr($i, eq + 1)
        found = 1
        exit
      }
    }
  } END { if (!found) print d }'
}

parse_entry() {
  local entry="$1"
  ENTRY_DOMAIN="$(printf '%s' "$entry" | cut -d';' -f1)"
  ENTRY_BACKEND_URL="$(printf '%s' "$entry" | cut -d';' -f2)"
  ENTRY_WILDCARD="$(printf '%s' "$entry" | cut -d';' -f3 | cut -d'=' -f2)"
  ENTRY_SSL="$(printf '%s' "$entry" | cut -d';' -f4 | cut -d'=' -f2)"
  ENTRY_MODE="$(entry_field_value "$entry" "mode" "generated")"
  ENTRY_PROFILE="$(entry_field_value "$entry" "profile" "$DEFAULT_PROFILE")"
  ENTRY_WEBSOCKET="$(entry_field_value "$entry" "websocket" "$DEFAULT_WEBSOCKET")"

  [[ -n "$ENTRY_MODE" ]] || ENTRY_MODE="generated"
  [[ -n "$ENTRY_PROFILE" ]] || ENTRY_PROFILE="$DEFAULT_PROFILE"

  # A row that does not declare the capability is an HTTP only row
  [[ "$ENTRY_WEBSOCKET" == "yes" ]] || ENTRY_WEBSOCKET="no"

  # The stored path is never trusted, but the two failure modes are different.
  # A missing key is a 3.5 or 3.6 row and takes the default. A key that is
  # present and does not validate is corrupted data, and substituting the
  # default there would silently publish a WebSocket endpoint on a path nobody
  # configured. Such a row is kept exactly as stored and flagged instead, so the
  # generated mode refuses to render it until the operator fixes it.
  ENTRY_WEBSOCKET_INVALID=0
  if entry_has_field "$entry" "websocket_path"; then
    local stored_path
    stored_path="$(entry_field_value "$entry" "websocket_path" "")"
    if ! ENTRY_WEBSOCKET_PATH="$(normalize_websocket_path "$stored_path")"; then
      ENTRY_WEBSOCKET_PATH="$stored_path"
      ENTRY_WEBSOCKET_INVALID=1
    fi
  else
    ENTRY_WEBSOCKET_PATH="$DEFAULT_WEBSOCKET_PATH"
  fi
}

websocket_capability_is_broken() {
  # True when the parsed row declares WebSockets on a path that cannot be
  # rendered. Nothing is generated or written while this holds.
  [[ "$ENTRY_WEBSOCKET" == "yes" ]] && (( ENTRY_WEBSOCKET_INVALID ))
}

websocket_path_suggestion() {
  # Default offered by the prompt, never a value that failed validation
  if (( ENTRY_WEBSOCKET_INVALID )) || [[ -z "$ENTRY_WEBSOCKET_PATH" ]]; then
    printf '%s' "$DEFAULT_WEBSOCKET_PATH"
    return 0
  fi
  printf '%s' "$ENTRY_WEBSOCKET_PATH"
}

select_domain_from_db() {
  if [[ ! -s "$DB_FILE" ]]; then
    badge_warn "no registered domains"
    sleep_soft
    return 1
  fi

  local lines=()
  local line
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    lines+=("$line")
  done < "$DB_FILE"

  local count="${#lines[@]}"
  (( count > 0 )) || { badge_warn "no registered domains"; sleep_soft; return 1; }

  echo -e "${BOLD}Select a domain${RESET}"
  echo

  local idx=0
  local ws_tag=""
  for line in "${lines[@]}"; do
    parse_entry "$line"
    ws_tag=""
    if websocket_capability_is_broken; then
      ws_tag="${FG_RED}[ws invalid path]${RESET}"
    elif [[ "$ENTRY_WEBSOCKET" == "yes" ]]; then
      ws_tag="${FG_BLUE}[ws ${ENTRY_WEBSOCKET_PATH}]${RESET}"
    fi
    printf "  %2d) %-35s %s %s %s %s\n" \
      "$((idx + 1))" \
      "${ENTRY_DOMAIN}" \
      "${FG_GRAY}${SYM_ARROW}${RESET}" \
      "${DIM}${ENTRY_BACKEND_URL}${RESET}" \
      "${FG_MAGENTA}[${ENTRY_MODE}]${RESET}" \
      "${ws_tag}"
    idx=$((idx + 1))
  done

  echo
  read -r -p "Number: " choice
  [[ "$choice" =~ ^[0-9]+$ ]] || { badge_warn "invalid selection"; sleep_soft; return 1; }

  local index=$((choice - 1))
  (( index >= 0 && index < count )) || { badge_warn "out of range"; sleep_soft; return 1; }

  parse_entry "${lines[$index]}"
  SELECTED_DOMAIN="$ENTRY_DOMAIN"
  return 0
}

###############################################################################
# SSL
###############################################################################
check_cert_files() {
  local domain="$1"
  [[ -f "${CERT_DIR}/${domain}.pem" && -f "${CERT_DIR}/${domain}.key" ]]
}

generate_self_signed_cert() {
  local domain="$1"
  local cert_file="${CERT_DIR}/${domain}.pem"
  local key_file="${CERT_DIR}/${domain}.key"

  badge_info "generating self signed certificate for ${domain}"
  log_line "INFO" "Generating self signed cert for ${domain}"

  openssl req -x509 -nodes -newkey rsa:2048 \
    -keyout "$key_file" \
    -out "$cert_file" \
    -days 365 \
    -subj "/CN=${domain}" >/dev/null 2>&1

  chmod 600 "$cert_file" "$key_file" 2>/dev/null || true
}

setup_ssl_for_domain() {
  local domain="$1"

  if check_cert_files "$domain"; then
    badge_info "existing certificate detected"
    echo "  ${CERT_DIR}/${domain}.pem"
    echo "  ${CERT_DIR}/${domain}.key"
    echo
    local opt
    opt="$(ask_choice "Choose, 1 use existing, 2 regenerate" "1 2")"
    if [[ "$opt" == "2" ]]; then
      generate_self_signed_cert "$domain"
    fi
  else
    badge_warn "no certificate found, creating a self signed one"
    generate_self_signed_cert "$domain"
  fi
}

###############################################################################
# Nginx config generation
###############################################################################
build_proxy_tuning_block() {
  # Timeouts are parameters so the WebSocket location can use longer values
  # without emitting the same directive twice, which Nginx rejects as duplicate.
  local read_timeout="${1:-$DEFAULT_PROXY_READ_TIMEOUT}"
  local send_timeout="${2:-$DEFAULT_PROXY_SEND_TIMEOUT}"

  cat <<EOF
        client_max_body_size ${DEFAULT_CLIENT_MAX_BODY_SIZE};
        client_body_timeout ${DEFAULT_CLIENT_BODY_TIMEOUT};
        send_timeout ${DEFAULT_SEND_TIMEOUT};

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout ${DEFAULT_PROXY_CONNECT_TIMEOUT};
        proxy_send_timeout ${send_timeout};
        proxy_read_timeout ${read_timeout};
EOF
}

generate_nginx_conf() {
  local domain="$1"
  local backend_url="$2"
  local wildcard="$3"
  local ssl="$4"
  local websocket="${5:-$DEFAULT_WEBSOCKET}"
  local websocket_path="${6:-$DEFAULT_WEBSOCKET_PATH}"
  local profile="${7:-$DEFAULT_PROFILE}"

  # Last gate before the value becomes Nginx syntax
  if [[ "$websocket" == "yes" ]]; then
    websocket_path="$(normalize_websocket_path "$websocket_path")" \
      || die "invalid websocket path for ${domain}"
  fi

  local conf_file="${NGINX_CONF_DIR}/${domain}.conf"
  local tmp="${conf_file}.new.$$"
  render_nginx_conf "$domain" "$backend_url" "$wildcard" "$ssl" \
    "$websocket" "$websocket_path" "$profile" >"$tmp"

  sanitize_text_file_inplace "$tmp"

  conf_must_not_contain_cr "$tmp" || die "CR detected in generated conf"
  conf_must_not_contain_forbidden_tokens "$tmp" || die "forbidden placeholder token detected in generated conf"

  mv -f "$tmp" "$conf_file"
  log_line "INFO" "Generated conf for ${domain} at ${conf_file}"
  badge_ok "generated config, ${conf_file}"
}

###############################################################################
# Audit and repair
###############################################################################
audit_all_confs() {
  header
  echo -e "${BOLD}conf.d audit${RESET}"
  echo

  local any=0
  local f

  shopt -s nullglob
  for f in "$NGINX_CONF_DIR"/*.conf; do
    local issues=()

    if LC_ALL=C grep -q $'\r' "$f" 2>/dev/null; then
      issues+=("CRLF detected")
    fi

    if grep -Eq "$FORBIDDEN_TOKENS_REGEX" "$f"; then
      issues+=("forbidden placeholder token detected")
    fi

    if LC_ALL=C grep -Pq '[^\x09\x0A\x0D\x20-\x7E]' "$f" 2>/dev/null; then
      issues+=("non printable characters detected")
    fi

    if (( ${#issues[@]} > 0 )); then
      any=1
      badge_warn "file, $f"
      local i
      for i in "${issues[@]}"; do
        echo "  ${SYM_ARROW} $i"
      done
      echo
    fi
  done
  shopt -u nullglob

  if [[ "$any" -eq 0 ]]; then
    badge_ok "no issues detected in conf.d"
  else
    badge_warn "issues detected, consider sanitizing"
  fi

  pause
}

sanitize_all_confs() {
  header
  echo -e "${BOLD}sanitize conf.d${RESET}"
  echo
  badge_warn "this will remove CRLF and non printable characters from all conf files"
  echo

  if ! ask_yes_no "proceed"; then
    badge_info "cancelled"
    sleep_soft
    return
  fi

  local backup_path
  backup_path="$(backup_nginx_confs)"
  badge_info "backup created, $backup_path"
  log_line "INFO" "Backup created at ${backup_path}"

  local f
  shopt -s nullglob
  for f in "$NGINX_CONF_DIR"/*.conf; do
    sanitize_text_file_inplace "$f"
  done
  shopt -u nullglob

  if nginx_test_quiet; then
    badge_ok "sanitization completed, nginx test ok"
    reload_nginx_portable || true
    log_line "INFO" "Sanitize applied and nginx reloaded"
  else
    badge_fail "nginx test failed after sanitization, rolling back"
    log_line "WARN" "nginx test failed after sanitize, rollback"
    restore_reverse_state "$backup_path" || true
    reload_nginx_portable || true
  fi

  pause
}

###############################################################################
# Domain actions
###############################################################################
create_domain() {
  header
  echo -e "${BOLD}Create domain${RESET}"
  echo

  local domain=""
  read -r -p "Domain, example.com: " domain
  if ! validate_domain "$domain"; then
    badge_fail "invalid domain format"
    sleep_soft
    return
  fi

  if db_entry_exists "$domain"; then
    badge_warn "domain already exists in registry"
    sleep_soft
    return
  fi

  echo
  echo -e "${FG_CYAN}${BOLD}Choose deployment type${RESET}"
  echo "  1 WordPress / PHP"
  echo "  2 Django"
  echo "  3 Flask / FastAPI"
  echo "  4 Static site"
  echo "  5 Generic service"
  echo

  local profile_choice="5"
  profile_choice="$(ask_choice "Profile" "1 2 3 4 5")"

  # The profile is persisted from here on, it drives UX and future defaults but
  # never decides a capability on its own
  local profile
  profile="$(profile_slug_from_choice "$profile_choice")"
  show_create_domain_guide "$profile"

  badge_info "backend examples"
  case "$profile_choice" in
    1)
      echo "  http://192.168.1.10:80"
      echo "  http://10.0.0.20:8080"
      ;;
    2)
      echo "  http://127.0.0.1:8000"
      echo "  http://10.0.0.20:8000"
      ;;
    3)
      echo "  http://127.0.0.1:5000"
      echo "  http://10.0.0.20:5000"
      ;;
    4)
      echo "  http://192.168.1.10:8080"
      echo "  http://10.0.0.20:8080"
      ;;
    *)
      echo "  http://192.168.2.116:80"
      echo "  http://10.0.0.20:8080"
      echo "  https://192.168.2.120:8443"
      ;;
  esac
  echo

  local raw_backend=""
  read -r -p "Backend URL: " raw_backend

  local backend_url=""
  if ! backend_url="$(normalize_backend_url "$raw_backend")"; then
    badge_fail "invalid backend url"
    sleep_soft
    return
  fi

  local wildcard="no"
  local ssl="no"

  echo
  if ask_yes_no "enable wildcard"; then
    wildcard="yes"
  fi

  echo
  if ask_yes_no "enable SSL on reverse"; then
    ssl="yes"
    setup_ssl_for_domain "$domain"
  fi

  ask_websocket_capability "$profile" "$DEFAULT_WEBSOCKET_PATH"
  local websocket="$ASK_WEBSOCKET"
  local websocket_path="$ASK_WEBSOCKET_PATH"

  local backup_path
  backup_path="$(backup_nginx_confs)"
  badge_info "backup created, $backup_path"
  log_line "INFO" "Backup created at ${backup_path}"

  # The path comes from a prompt that only returns validated values, so this
  # can only fail if the registry write itself was refused
  if ! db_save_entry "$domain" "$backend_url" "$wildcard" "$ssl" "generated" \
    "$profile" "$websocket" "$websocket_path"; then
    badge_fail "domain not registered, nothing was applied"
    pause
    return
  fi

  generate_nginx_conf "$domain" "$backend_url" "$wildcard" "$ssl" \
    "$websocket" "$websocket_path" "$profile"

  if safe_reload_nginx "$backup_path"; then
    badge_ok "domain created and applied safely"
    log_line "INFO" "Domain created and applied, ${domain}"
    if [[ "$websocket" == "yes" ]]; then
      log_line "INFO" "WebSocket capability enabled for ${domain} path=${websocket_path}"
    fi
  else
    badge_fail "apply failed, rollback attempted"
    log_line "ERROR" "Create apply failed, ${domain}"
  fi

  pause
}

list_domains() {
  header
  echo -e "${BOLD}Registered domains${RESET}"
  echo

  if [[ ! -s "$DB_FILE" ]]; then
    badge_warn "no registered domains"
    pause
    return
  fi

  printf "%-35s %-45s %-10s %-6s %-10s %-20s\n" \
    "Domain" "Backend URL" "Wildcard" "SSL" "Mode" "WebSocket"
  printf "%-35s %-45s %-10s %-6s %-10s %-20s\n" \
    "-----" "----------" "--------" "---" "----" "---------"

  local line
  local ws_column
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    parse_entry "$line"

    ws_column="no"
    if websocket_capability_is_broken; then
      ws_column="INVALID PATH"
    elif [[ "$ENTRY_WEBSOCKET" == "yes" ]]; then
      ws_column="yes ${ENTRY_WEBSOCKET_PATH}"
    fi

    printf "%-35s %-45s %-10s %-6s %-10s %-20s\n" \
      "$ENTRY_DOMAIN" \
      "$ENTRY_BACKEND_URL" \
      "$ENTRY_WILDCARD" \
      "$ENTRY_SSL" \
      "$ENTRY_MODE" \
      "$ws_column"
  done < "$DB_FILE"

  pause
}

view_domain_conf() {
  header
  echo -e "${BOLD}View domain Nginx config${RESET}"
  echo

  if ! select_domain_from_db; then
    return
  fi

  local conf="${NGINX_CONF_DIR}/${SELECTED_DOMAIN}.conf"
  if [[ ! -f "$conf" ]]; then
    badge_fail "conf not found for ${SELECTED_DOMAIN}"
    pause
    return
  fi

  badge_info "showing, ${conf}"
  echo
  if command -v less >/dev/null 2>&1; then
    less "$conf"
  else
    cat "$conf"
    pause
  fi
}

delete_domain() {
  header
  echo -e "${BOLD}Delete domain${RESET}"
  echo

  if ! select_domain_from_db; then
    return
  fi

  echo
  badge_warn "this will remove the DB entry, the vhost conf, and cert files if present"
  echo

  if ! ask_yes_no "confirm delete ${SELECTED_DOMAIN}"; then
    badge_info "cancelled"
    sleep_soft
    return
  fi

  local backup_path
  backup_path="$(backup_nginx_confs)"
  badge_info "backup created, $backup_path"
  log_line "INFO" "Backup created at ${backup_path}"

  # Remove DB entry
  db_delete_entry "$SELECTED_DOMAIN"

  # Remove associated Nginx vhost
  rm -f "${NGINX_CONF_DIR}/${SELECTED_DOMAIN}.conf" 2>/dev/null || true

  # Remove associated SSL files
  rm -f "${CERT_DIR}/${SELECTED_DOMAIN}.pem" 2>/dev/null || true
  rm -f "${CERT_DIR}/${SELECTED_DOMAIN}.key" 2>/dev/null || true

  if safe_reload_nginx "$backup_path"; then
    badge_ok "domain deleted and applied safely"
    log_line "INFO" "Domain deleted and applied, ${SELECTED_DOMAIN}"
  else
    badge_fail "apply failed, rollback attempted"
    log_line "ERROR" "Delete apply failed, ${SELECTED_DOMAIN}"
  fi

  pause
}

save_domain_edits() {
  local backup_path="$1"
  local conf_path="$2"

  # Nothing is applied while the declared capability cannot be rendered, in
  # either mode. The registry keeps the value it already has, the operator
  # decides whether to fix the path or turn the capability off.
  if websocket_capability_is_broken; then
    badge_fail "stored websocket path is invalid, ${ENTRY_WEBSOCKET_PATH}"
    badge_info "fix it with option 5, or disable websocket support with option 4"
    log_line "ERROR" "Refused to apply ${ENTRY_DOMAIN}, invalid stored websocket path"
    return 1
  fi

  if [[ "$ENTRY_MODE" == "manual" ]]; then
    if [[ ! -f "$conf_path" ]]; then
      badge_fail "manual conf file not found"
      restore_reverse_state "$backup_path" || true
      entry="$(db_get_entry_exact "$ENTRY_DOMAIN" 2>/dev/null || true)"
      [[ -n "$entry" ]] && parse_entry "$entry"
      return 1
    fi
    if ! validate_conf_for_domain "$conf_path"; then
      badge_fail "manual conf contains forbidden content"
      restore_reverse_state "$backup_path" || true
      entry="$(db_get_entry_exact "$ENTRY_DOMAIN" 2>/dev/null || true)"
      [[ -n "$entry" ]] && parse_entry "$entry"
      return 1
    fi
    # Manual mode keeps the operator's file, only the registry row is refreshed
    if ! db_save_entry "$ENTRY_DOMAIN" "$ENTRY_BACKEND_URL" "$ENTRY_WILDCARD" "$ENTRY_SSL" "manual" \
      "$ENTRY_PROFILE" "$ENTRY_WEBSOCKET" "$ENTRY_WEBSOCKET_PATH"; then
      badge_fail "registry not updated, nothing was applied"
      return 1
    fi
  else
    if ! db_save_entry "$ENTRY_DOMAIN" "$ENTRY_BACKEND_URL" "$ENTRY_WILDCARD" "$ENTRY_SSL" "generated" \
      "$ENTRY_PROFILE" "$ENTRY_WEBSOCKET" "$ENTRY_WEBSOCKET_PATH"; then
      badge_fail "registry not updated, nothing was applied"
      return 1
    fi
    generate_nginx_conf "$ENTRY_DOMAIN" "$ENTRY_BACKEND_URL" "$ENTRY_WILDCARD" "$ENTRY_SSL" \
      "$ENTRY_WEBSOCKET" "$ENTRY_WEBSOCKET_PATH" "$ENTRY_PROFILE"
  fi

  if safe_reload_nginx "$backup_path"; then
    EDIT_DIRTY=0
    badge_ok "updated and applied safely"
    log_line "INFO" "Domain updated and applied, ${ENTRY_DOMAIN}"
    # Records the capability state that is actually live, the toggle log above
    # only records what the operator asked for
    log_line "INFO" "Applied capabilities for ${ENTRY_DOMAIN}, websocket=${ENTRY_WEBSOCKET} path=${ENTRY_WEBSOCKET_PATH}"
    return 0
  fi

  local entry
  entry="$(db_get_entry_exact "$ENTRY_DOMAIN" 2>/dev/null || true)"
  [[ -n "$entry" ]] && parse_entry "$entry"
  EDIT_DIRTY=1
  badge_fail "apply failed, rollback attempted"
  log_line "ERROR" "Update apply failed, ${ENTRY_DOMAIN}"
  return 1
}

edit_domain_conf_manually() {
  local conf_path="$1"

  if ! editor_supports_manual_edit; then
    badge_fail "no text editor available, set EDITOR or VISUAL"
    return 1
  fi

  if open_file_in_editor "$conf_path"; then
    sanitize_text_file_inplace "$conf_path"
    ENTRY_MODE="manual"
    EDIT_DIRTY=1
    badge_ok "manual edit captured"
    log_line "INFO" "Manual edit captured for ${ENTRY_DOMAIN}"
    return 0
  fi

  badge_fail "editor session failed"
  return 1
}

edit_domain() {
  header
  echo -e "${BOLD}Edit domain${RESET}"
  echo

  if ! select_domain_from_db; then
    return
  fi

  local entry=""
  entry="$(db_get_entry_exact "$SELECTED_DOMAIN" 2>/dev/null || true)"
  [[ -n "$entry" ]] || { badge_fail "domain not found in DB"; pause; return; }

  parse_entry "$entry"
  local conf_path
  conf_path="$(domain_conf_path "$ENTRY_DOMAIN")"
  SESSION_BACKUP_PATH="$(backup_reverse_state)"
  EDIT_DIRTY=0
  local conf_was_missing=0
  if [[ ! -f "$conf_path" ]]; then
    conf_was_missing=1
  fi
  ensure_domain_conf_present "$ENTRY_DOMAIN" "$ENTRY_BACKEND_URL" "$ENTRY_WILDCARD" "$ENTRY_SSL" \
    "$ENTRY_WEBSOCKET" "$ENTRY_WEBSOCKET_PATH" "$ENTRY_PROFILE"
  if (( conf_was_missing )); then
    EDIT_DIRTY=1
  fi

  while true; do
    header
    echo -e "${BOLD}Editing${RESET}, ${FG_GREEN}${ENTRY_DOMAIN}${RESET}"
    echo
    badge_info "backend, ${ENTRY_BACKEND_URL}"
    badge_info "profile, $(profile_label "$ENTRY_PROFILE")"
    badge_info "wildcard, ${ENTRY_WILDCARD}"
    badge_info "ssl, ${ENTRY_SSL}"
    badge_info "mode, ${ENTRY_MODE}"
    if websocket_capability_is_broken; then
      badge_fail "websocket, yes, stored path is invalid, ${ENTRY_WEBSOCKET_PATH}"
      badge_warn "nothing can be applied until the path is fixed or websocket is disabled"
    elif [[ "$ENTRY_WEBSOCKET" == "yes" ]]; then
      badge_info "websocket, yes, path ${ENTRY_WEBSOCKET_PATH}"
    else
      badge_info "websocket, no"
    fi
    if (( EDIT_DIRTY )); then
      badge_warn "pending changes"
    else
      badge_ok "session clean"
    fi
    echo
    echo -e "${FG_CYAN}${BOLD}Options${RESET}"
    echo "  1 Change backend URL"
    echo "  2 Toggle wildcard"
    echo "  3 Toggle SSL"
    echo "  4 Toggle WebSocket support"
    echo "  5 Change WebSocket path"
    echo "  6 Edit full config manually"
    echo "  7 Save and apply changes"
    echo "  8 Discard changes"
    echo "  0 Back"
    echo

    local opt
    read -r -p "Option: " opt

    case "$opt" in
      1)
        if [[ "$ENTRY_MODE" == "manual" ]]; then
          badge_warn "structured edits will replace the manual file on save"
        fi
        local raw=""
        read -r -p "New backend URL: " raw
        local nb=""
        if ! nb="$(normalize_backend_url "$raw")"; then
          badge_fail "invalid backend url"
          sleep_soft
          continue
        fi
        ENTRY_BACKEND_URL="$nb"
        ENTRY_MODE="generated"
        EDIT_DIRTY=1
        ;;
      2)
        if [[ "$ENTRY_MODE" == "manual" ]]; then
          badge_warn "structured edits will replace the manual file on save"
        fi
        if [[ "$ENTRY_WILDCARD" == "yes" ]]; then
          ENTRY_WILDCARD="no"
        else
          ENTRY_WILDCARD="yes"
        fi
        ENTRY_MODE="generated"
        EDIT_DIRTY=1
        ;;
      3)
        if [[ "$ENTRY_MODE" == "manual" ]]; then
          badge_warn "structured edits will replace the manual file on save"
        fi
        if [[ "$ENTRY_SSL" == "yes" ]]; then
          ENTRY_SSL="no"
        else
          ENTRY_SSL="yes"
          setup_ssl_for_domain "$ENTRY_DOMAIN"
        fi
        ENTRY_MODE="generated"
        EDIT_DIRTY=1
        ;;
      4)
        if [[ "$ENTRY_MODE" == "manual" ]]; then
          badge_warn "structured edits will replace the manual file on save"
        fi
        if [[ "$ENTRY_WEBSOCKET" == "yes" ]]; then
          ENTRY_WEBSOCKET="no"
          badge_ok "websocket disabled, the ${ENTRY_WEBSOCKET_PATH} location will be removed on save"
          log_line "INFO" "WebSocket capability disabled for ${ENTRY_DOMAIN}"
          if (( ENTRY_WEBSOCKET_INVALID )); then
            # The stored value was never a usable path, it is not carried
            # forward for a later re-enable
            ENTRY_WEBSOCKET_PATH="$DEFAULT_WEBSOCKET_PATH"
            ENTRY_WEBSOCKET_INVALID=0
            badge_info "the invalid stored path was dropped, default is ${ENTRY_WEBSOCKET_PATH}"
          fi
        else
          ENTRY_WEBSOCKET="yes"
          ask_websocket_path "$(websocket_path_suggestion)"
          ENTRY_WEBSOCKET_PATH="$ASK_WEBSOCKET_PATH"
          ENTRY_WEBSOCKET_INVALID=0
          badge_ok "websocket enabled, path ${ENTRY_WEBSOCKET_PATH}"
          log_line "INFO" "WebSocket capability enabled for ${ENTRY_DOMAIN} path=${ENTRY_WEBSOCKET_PATH}"
        fi
        ENTRY_MODE="generated"
        EDIT_DIRTY=1
        sleep_soft
        ;;
      5)
        if [[ "$ENTRY_WEBSOCKET" != "yes" ]]; then
          badge_warn "websocket is disabled, enable it first with option 4"
          sleep_soft
          continue
        fi
        if [[ "$ENTRY_MODE" == "manual" ]]; then
          badge_warn "structured edits will replace the manual file on save"
        fi
        local previous_path="$ENTRY_WEBSOCKET_PATH"
        ask_websocket_path "$(websocket_path_suggestion)"
        ENTRY_WEBSOCKET_PATH="$ASK_WEBSOCKET_PATH"
        if [[ "$ENTRY_WEBSOCKET_PATH" != "$previous_path" ]]; then
          log_line "INFO" "WebSocket path changed for ${ENTRY_DOMAIN}, ${previous_path} to ${ENTRY_WEBSOCKET_PATH}"
          ENTRY_MODE="generated"
          EDIT_DIRTY=1
        fi
        # A path that came back from the prompt is valid by construction
        ENTRY_WEBSOCKET_INVALID=0
        sleep_soft
        ;;
      6)
        edit_domain_conf_manually "$conf_path"
        sleep_soft
        ;;
      7)
        local backup_path
        backup_path="$SESSION_BACKUP_PATH"
        if [[ -z "$backup_path" ]]; then
          backup_path="$(backup_reverse_state)"
          SESSION_BACKUP_PATH="$backup_path"
        fi
        badge_info "backup created, $backup_path"
        log_line "INFO" "Backup created at ${backup_path}"

        save_domain_edits "$backup_path" "$conf_path"
        pause
        ;;
      8)
        if ask_yes_no "discard all changes for ${ENTRY_DOMAIN}"; then
          restore_reverse_state "$SESSION_BACKUP_PATH" || true
          entry="$(db_get_entry_exact "$ENTRY_DOMAIN" 2>/dev/null || true)"
          [[ -n "$entry" ]] && parse_entry "$entry"
          EDIT_DIRTY=0
          badge_info "changes discarded"
          sleep_soft
        fi
        ;;
      0)
        if (( EDIT_DIRTY )); then
          if ask_yes_no "discard pending changes and go back"; then
            restore_reverse_state "$SESSION_BACKUP_PATH" || true
            badge_info "changes discarded"
            EDIT_DIRTY=0
            break
          fi
          continue
        fi
        break
        ;;
      *)
        badge_warn "invalid option"
        sleep_soft
        ;;
    esac
  done
}

test_nginx() {
  header
  echo -e "${BOLD}Nginx configuration test${RESET}"
  echo
  nginx_test_verbose || true
  pause
}

safe_reload_menu() {
  header
  echo -e "${BOLD}Safe Nginx reload${RESET}"
  echo

  local backup_path
  backup_path="$(backup_nginx_confs)"
  badge_info "backup created, $backup_path"
  log_line "INFO" "Backup created at ${backup_path}"

  if safe_reload_nginx "$backup_path"; then
    badge_ok "safe reload completed"
  else
    badge_fail "safe reload failed, check logs"
  fi
  pause
}

env_check() {
  header
  echo -e "${BOLD}Environment check${RESET}"
  echo

  if command -v nginx >/dev/null 2>&1; then
    badge_ok "nginx found, $(command -v nginx)"
  else
    badge_fail "nginx not found"
  fi

  echo
  badge_info "paths"
  echo "  conf dir, $NGINX_CONF_DIR"
  echo "  db file,  $DB_FILE"
  echo "  cert dir, $CERT_DIR"
  echo "  backup,   $BACKUP_DIR"
  echo "  log file, $LOG_FILE"

  echo
  if systemctl list-unit-files 2>/dev/null | grep -q '^nginx\.service'; then
    badge_ok "nginx.service detected"
  else
    badge_warn "nginx.service not detected"
  fi

  echo
  if command -v systemctl >/dev/null 2>&1; then
    badge_ok "systemctl available for reloads"
  elif command -v service >/dev/null 2>&1; then
    badge_ok "service available for reloads"
  elif command -v nginx >/dev/null 2>&1; then
    badge_ok "nginx -s reload available"
  else
    badge_fail "no reload mechanism found"
  fi

  pause
}

###############################################################################
# Main menu
###############################################################################
main_menu() {
  while true; do
    header
    echo -e "${FG_CYAN}${BOLD}Main menu${RESET}"
    echo
    echo -e "  ${FG_GREEN}1${RESET}  Create domain"
    echo -e "  ${FG_GREEN}2${RESET}  List domains"
    echo -e "  ${FG_GREEN}3${RESET}  View domain conf"
    echo -e "  ${FG_GREEN}4${RESET}  Edit domain"
    echo -e "  ${FG_GREEN}5${RESET}  Delete domain"
    echo -e "  ${FG_GREEN}6${RESET}  Test Nginx"
    echo -e "  ${FG_GREEN}7${RESET}  Safe reload Nginx"
    echo -e "  ${FG_GREEN}8${RESET}  Audit conf.d"
    echo -e "  ${FG_GREEN}9${RESET}  Sanitize conf.d"
    echo -e "  ${FG_GREEN}10${RESET} Environment check"
    echo -e "  ${FG_GREEN}0${RESET}  Exit"
    echo

    read -r -p "Option: " c
    case "$c" in
      1) create_domain ;;
      2) list_domains ;;
      3) view_domain_conf ;;
      4) edit_domain ;;
      5) delete_domain ;;
      6) test_nginx ;;
      7) safe_reload_menu ;;
      8) audit_all_confs ;;
      9) sanitize_all_confs ;;
      10) env_check ;;
      0) exit 0 ;;
      *)
        badge_warn "invalid option"
        sleep_soft
        ;;
    esac
  done
}

###############################################################################
# Boot
###############################################################################
# The TUI only starts when the file is executed. Sourcing it exposes the
# helpers to the test suite without touching the system or requiring root.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  require_root
  ensure_paths
  log_line "INFO" "Started ${APP_NAME} ${APP_VERSION}"
  main_menu
fi
